# Runs on the WORKSTATION (pro6000), NOT the robot. Exposes the robot's dashboard/camera
# ports on the workstation's localhost so VS Code Remote-SSH auto-forwards them to a laptop.
[Unit]
Description=Forward Lite3 dashboard ports (8080/8888) to workstation localhost for VS Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paul
ExecStart=/usr/bin/python3 -u /home/paul/.local/hydra-forward/hydra_forward.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
