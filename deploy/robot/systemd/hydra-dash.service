[Unit]
Description=HydraNet Lite3 Playground dashboard (:8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paul
WorkingDirectory=/home/paul/playground
ExecStart=/usr/bin/python3 -u /home/paul/playground/hydra_dash.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
